@import url("IndustryTokens.uss");

/* ===== BASE ===== */

.root {
    flex-grow: 1;
    -unity-font-style: normal;
    color: var(--text-primary);
    font-size: 16px;
    background-color: rgba(0, 0, 0, 0);
}

.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 6, 8, 0.78);
}

.bg-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--bg-0);
    justify-content: center;
    align-items: center;
}

.row {
    flex-direction: row;
    align-items: center;
}

.col {
    flex-direction: column;
    min-height: 0;
}

.grow {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
}

.scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

.search-host {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    min-height: auto;
    margin-bottom: 8px;
    overflow: visible;
}

.search-host .label-caps {
    flex-shrink: 0;
    margin-bottom: 4px;
}

.unity-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    position: relative;
}

.grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.divider {
    height: 1px;
    background-color: var(--border-subtle);
    margin-top: 16px;
    margin-bottom: 16px;
    flex-shrink: 0;
}

/* ===== TYPOGRAPHY ===== */

.display {
    font-size: 44px;
    color: var(--text-primary);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 8px;
}

.heading-1,
.title-hero {
    font-size: 32px;
    color: var(--accent);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.heading-2,
.title {
    font-size: 24px;
    color: var(--accent);
    -unity-font-style: bold;
    flex-grow: 1;
}

.heading-3 {
    font-size: 20px;
    color: var(--text-primary);
    -unity-font-style: bold;
}

.body-text {
    font-size: 16px;
    color: var(--text-primary);
    white-space: normal;
}

.body-small {
    font-size: 14px;
    color: var(--text-secondary);
    white-space: normal;
}

.caption,
.muted,
.tagline {
    font-size: 13px;
    color: var(--text-muted);
    white-space: normal;
}

.tagline {
    font-size: 15px;
    margin-bottom: 32px;
}

.numeric,
.gold {
    font-size: 20px;
    color: var(--accent);
    -unity-font-style: bold;
}

.ruby {
    font-size: 20px;
    color: rgb(196, 86, 102);
    -unity-font-style: bold;
}

.label-caps {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 1px;
}

.ok {
    color: var(--success);
    font-size: 13px;
    -unity-font-style: bold;
}

.warn {
    color: var(--warning);
    font-size: 13px;
    -unity-font-style: bold;
}

/* ===== PANELS ===== */

.panel,
.panel-root {
    background-color: var(--surface-overlay);
    border-color: var(--border-normal);
    border-width: 1px;
    border-left-width: 2px;
    border-left-color: var(--accent);
    border-radius: 2px;
    padding: 24px;
    flex-direction: column;
    overflow: hidden;
    transition-property: opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.panel-wide {
    width: 90%;
    max-width: 1120px;
    height: 82%;
    max-height: 820px;
    min-height: 420px;
    align-self: center;
    margin-top: 32px;
    overflow: hidden;
}

.panel-menu {
    width: 480px;
    max-width: 90%;
    max-height: 86%;
    align-self: center;
    padding: 40px 40px 32px 40px;
}

/* ===== SETTINGS (sidebar tabs + rows) ===== */

.settings-shell {
    width: 1060px;
    max-width: 94%;
    height: 720px;
    max-height: 90%;
    padding: 0;
    flex-direction: column;
    overflow: hidden;
    background-color: rgba(10, 13, 17, 0.97);
    border-left-width: 1px;
    border-left-color: var(--border-normal);
    border-top-width: 2px;
    border-top-color: var(--accent);
}

.set-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 18px 28px 16px 28px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
    background-color: rgba(214, 148, 62, 0.05);
}

.set-title {
    font-size: 24px;
    color: var(--text-primary);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin: 0;
}

.set-live {
    font-size: 12px;
    color: var(--text-muted);
}

.set-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* --- sidebar --- */

.set-nav {
    width: 250px;
    flex-shrink: 0;
    padding: 12px 0;
    background-color: var(--bg-1);
    border-right-width: 1px;
    border-right-color: var(--border-subtle);
}

.set-nav-btn {
    flex-direction: row;
    align-items: stretch;
    padding: 0;
    margin: 0 10px 2px 10px;
    border-radius: 3px;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.set-nav-btn:hover {
    background-color: var(--surface-1);
}

.set-nav-btn.is-selected {
    background-color: var(--accent-muted);
}

.set-nav-bar {
    width: 3px;
    flex-shrink: 0;
    border-radius: 2px;
    margin: 8px 0;
    background-color: rgba(0, 0, 0, 0);
}

.set-nav-btn.is-selected .set-nav-bar {
    background-color: var(--accent);
}

.set-nav-text {
    flex-grow: 1;
    padding: 9px 12px;
}

.set-nav-title {
    font-size: 15px;
    color: var(--text-secondary);
    -unity-font-style: bold;
    margin: 0;
}

.set-nav-btn:hover .set-nav-title {
    color: var(--text-primary);
}

.set-nav-btn.is-selected .set-nav-title {
    color: var(--accent);
}

.set-nav-desc {
    font-size: 11px;
    color: var(--text-muted);
    white-space: normal;
    margin-top: 2px;
}

/* --- content --- */

.set-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    padding: 20px 8px 0 32px;
}

.set-page-title {
    font-size: 20px;
    color: var(--text-primary);
    -unity-font-style: bold;
    margin: 0;
    flex-shrink: 0;
}

.set-page-desc {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 2px;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.set-page {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-right: 20px;
    padding-bottom: 20px;
}

.set-group {
    flex-direction: row;
    align-items: center;
    margin-top: 22px;
    margin-bottom: 6px;
}

.set-group-title {
    font-size: 11px;
    color: var(--accent);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin: 0 10px 0 0;
}

.set-group-line {
    flex-grow: 1;
    height: 1px;
    background-color: var(--border-subtle);
}

/* --- rows --- */

.set-row {
    flex-direction: row;
    align-items: center;
    min-height: 48px;
    padding: 8px 12px;
    margin-bottom: 2px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.015);
    transition-property: background-color;
    transition-duration: 0.1s;
}

.set-row:hover {
    background-color: var(--surface-1);
}

.set-row-wide {
    flex-wrap: wrap;
}

.set-row-wide .set-ctl {
    max-width: 100%;
}

.set-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 180px;
    padding-right: 16px;
}

.set-label {
    font-size: 14px;
    color: var(--text-primary);
    margin: 0;
    white-space: normal;
}

.set-desc {
    font-size: 12px;
    color: var(--text-muted);
    white-space: normal;
    margin-top: 3px;
}

.set-ctl {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    flex-wrap: wrap;
    max-width: 62%;
}

/* switch */

.set-switch-state {
    font-size: 12px;
    color: var(--text-muted);
    margin-right: 10px;
    min-width: 34px;
    -unity-text-align: middle-right;
}

.set-switch {
    width: 42px;
    height: 22px;
    border-radius: 11px;
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border-normal);
    justify-content: center;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.set-knob {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin-left: 2px;
    background-color: var(--text-muted);
    transition-property: translate, background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.set-row.is-on .set-switch {
    background-color: var(--accent-muted);
    border-color: var(--accent);
}

.set-row.is-on .set-knob {
    translate: 20px 0;
    background-color: var(--accent);
}

.set-row.is-on .set-switch-state {
    color: var(--accent);
}

.set-row.is-cheat.is-on .set-switch {
    background-color: rgba(186, 72, 68, 0.2);
    border-color: var(--danger);
}

.set-row.is-cheat.is-on .set-knob {
    background-color: var(--danger);
}

.set-row.is-cheat.is-on .set-switch-state {
    color: var(--danger);
}

/* slider */

.set-slider {
    width: 240px;
    margin: 0;
    height: 20px;
}

.set-slider .unity-base-slider__drag-container {
    height: 20px;
}

.set-slider .unity-base-slider__tracker {
    height: 4px;
    border-radius: 2px;
    border-width: 0;
    background-color: var(--surface-2);
    margin-top: -2px;
}

.set-slider .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 2px;
    border-color: var(--bg-0);
    background-color: var(--accent);
    margin-top: -7px;
}

.set-value {
    width: 68px;
    margin-left: 12px;
    font-size: 13px;
    color: var(--accent);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

/* segmented choice */

.set-seg {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
}

Button.set-seg-btn {
    height: 28px;
    min-width: 44px;
    margin: 2px 0 2px 4px;
    padding: 0 12px;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 3px;
    justify-content: center;
}

Button.set-seg-btn .btn-label {
    font-size: 12px;
    color: var(--text-secondary);
}

Button.set-seg-btn:hover {
    border-color: var(--border-strong);
    background-color: var(--surface-2);
}

Button.set-seg-btn.is-selected {
    border-color: var(--accent);
    background-color: var(--accent-muted);
}

Button.set-seg-btn.is-selected .btn-label {
    color: var(--accent);
    -unity-font-style: bold;
}

/* dropdown + action */

.set-dropdown {
    width: 240px;
    margin: 0;
}

.set-action {
    margin: 0;
}

/* keybinds inside the controls tab */

.set-keys {
    padding: 0 12px;
}

.set-keys .key-group {
    margin-top: 14px;
    margin-bottom: 4px;
    color: var(--text-muted);
}

.set-keys .key-row {
    min-height: 40px;
    padding: 4px 0;
}

/* footer */

.set-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 12px 28px;
    background-color: var(--bg-1);
    border-top-width: 1px;
    border-top-color: var(--border-subtle);
}

.set-back {
    margin: 0;
    min-width: 140px;
}

/* ===== MINIMAP DRAG MODE ===== */

.mini-drag-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 6, 8, 0.45);
    align-items: center;
    justify-content: center;
}

.mini-drag-card {
    padding: 18px 22px;
    align-items: center;
    max-width: 440px;
}

.mini-drag-title {
    font-size: 18px;
    color: var(--accent);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.mini-drag-hint {
    font-size: 13px;
    color: var(--text-secondary);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.mini-drag-row .btn {
    margin: 0 4px;
}

.mini-host.is-mini-dragging {
    border-width: 2px;
    border-color: var(--accent);
    border-radius: 4px;
    padding: 4px;
    background-color: rgba(214, 148, 62, 0.08);
}

.volume-row {
    flex-shrink: 0;
    margin-bottom: 6px;
}

.volume-row .unity-base-slider {
    height: 16px;
    margin-bottom: 4px;
}

.panel-header,
.header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    min-height: 36px;
    flex-shrink: 0;
}

.panel-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
}

.panel-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
    flex-shrink: 0;
}

.panel-section {
    margin-bottom: 16px;
}

.panel-floating {
    background-color: var(--surface-overlay);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: 2px;
    padding: 8px 12px;
}

.header-icon {
    width: 32px;
    height: 32px;
    margin-right: 12px;
    flex-shrink: 0;
}

.header-sub {
    font-size: 13px;
    color: var(--text-muted);
}

/* ===== BUTTONS ===== */

.btn {
    height: 44px;
    background-color: var(--surface-2);
    border-color: var(--border-normal);
    border-width: 1px;
    border-radius: 2px;
    margin-bottom: 8px;
    padding: 0 16px;
    justify-content: center;
    align-items: center;
    transition-property: background-color, border-color;
    transition-duration: 0.1s;
}

.btn:hover {
    background-color: var(--surface-interactive);
    border-color: var(--accent);
}

.btn:active {
    background-color: var(--bg-2);
}

.btn:focus {
    border-color: var(--accent);
    border-width: 2px;
}

.btn-label {
    font-size: 16px;
    color: var(--text-primary);
}

.btn-primary {
    background-color: var(--accent-muted);
    border-color: var(--accent);
}

.btn-primary .btn-label {
    color: var(--accent);
}

.btn-primary:hover {
    background-color: rgba(214, 148, 62, 0.28);
}

.btn-danger {
    background-color: rgba(186, 72, 68, 0.16);
    border-color: var(--danger);
    margin-top: 16px;
}

.btn-danger .btn-label {
    color: rgb(220, 140, 136);
}

.btn-ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--border-subtle);
}

.btn-small {
    height: 32px;
    min-width: 88px;
    margin-bottom: 0;
    margin-left: 8px;
    padding: 0 12px;
}

.btn-small .btn-label {
    font-size: 13px;
}

.close {
    width: 36px;
    height: 36px;
    min-width: 36px;
    background-color: rgba(186, 72, 68, 0.12);
    border-color: var(--danger);
    border-width: 1px;
    border-radius: 2px;
    justify-content: center;
    align-items: center;
    margin-left: 12px;
    margin-bottom: 0;
    padding: 0;
}

.close:hover {
    background-color: rgba(186, 72, 68, 0.32);
}

.close .btn-label {
    font-size: 16px;
    color: rgb(220, 140, 136);
}

/* ===== TABS ===== */

.tab-row {
    flex-direction: row;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.tab {
    flex-grow: 1;
    height: 36px;
    margin-right: 8px;
    margin-bottom: 0;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-bottom-width: 2px;
    border-radius: 2px;
    justify-content: center;
    align-items: center;
}

.tab .btn-label {
    font-size: 13px;
    color: var(--text-secondary);
}

.tab-on,
.tab.is-selected {
    border-color: var(--accent);
    background-color: var(--accent-muted);
}

.tab-on .btn-label,
.tab.is-selected .btn-label {
    color: var(--accent);
    -unity-font-style: bold;
}

/* ===== CARDS (only for standalone objects) ===== */

.card {
    background-color: var(--surface-1);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: 2px;
    padding: 12px 16px;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
}

.card:hover {
    background-color: var(--surface-2);
    border-color: var(--border-normal);
}

.card-icon {
    width: 48px;
    height: 48px;
    margin-right: 12px;
    flex-shrink: 0;
}

Button.card {
    height: auto;
    background-color: var(--surface-1);
    border-color: var(--border-subtle);
    border-width: 1px;
    padding: 12px 16px;
}

Button.card:hover {
    background-color: var(--surface-2);
}

.card-on,
.card.is-selected,
Button.card-on {
    background-color: var(--accent-muted);
    border-color: var(--accent);
}

.card-locked,
.card.is-locked {
    opacity: 0.5;
}

.card-building {
    flex-direction: column;
    width: 168px;
    min-height: 188px;
    margin-right: 8px;
    margin-bottom: 8px;
    align-items: center;
    padding: 16px 12px;
}

.card-building .card-icon {
    width: 64px;
    height: 64px;
    margin-right: 0;
    margin-bottom: 8px;
}

.card-building-compact {
    flex-direction: row;
    width: auto;
    min-width: 220px;
    min-height: 56px;
    align-items: center;
    padding: 8px 12px;
}

.card-building-compact .card-icon {
    width: 40px;
    height: 40px;
    margin-right: 12px;
    margin-bottom: 0;
}

.card-cat {
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 4px;
}

.card-cost {
    font-size: 14px;
    color: var(--accent);
    -unity-font-style: bold;
    margin-top: 8px;
}

/* ===== STAT ROWS (not cards) ===== */

.stat-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
    margin-bottom: 0;
}

.stat-name {
    flex-grow: 1;
    font-size: 14px;
    color: var(--text-secondary);
}

.stat-value {
    font-size: 14px;
    color: var(--text-primary);
    -unity-font-style: bold;
}

/* ===== CHIPS / RESOURCES ===== */

.chip {
    background-color: var(--surface-0);
    border-radius: 2px;
    padding: 8px 12px;
    flex-direction: row;
    align-items: center;
}

.hud-stack {
    position: absolute;
    left: var(--hud-inset);
    top: var(--hud-inset);
    flex-direction: column;
    align-items: flex-start;
    max-width: 340px;
}

.resource-chip,
.hud-chip {
    min-width: 0;
    background-color: var(--surface-overlay);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: 2px;
    padding: 8px 12px;
    flex-direction: column;
    align-items: flex-start;
}

.hud-toasts {
    margin-top: 8px;
    width: 280px;
    flex-direction: column;
    align-items: stretch;
}

.hud-toasts .toast {
    margin-bottom: 6px;
}

.hud-line {
    flex-direction: row;
    align-items: center;
    margin-right: 16px;
    margin-bottom: 0;
}

.hud-chip .gold,
.hud-chip .ruby {
    font-size: 18px;
}

.hud-cost {
    margin-top: 4px;
    font-size: 14px;
    color: var(--accent);
}

.resource-chip__icon,
.icon-24 {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    flex-shrink: 0;
}

.icon-32 {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    flex-shrink: 0;
}

.icon-48 {
    width: 32px;
    height: 32px;
    margin-right: 12px;
    flex-shrink: 0;
}

.icon-64 {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
}

/* ===== HOTBAR ===== */

.hotbar-root {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.hotbar {
    flex-direction: row;
    align-items: center;
    background-color: var(--surface-overlay);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: 2px;
    padding: 6px 8px;
}

.slot,
.hotbar-slot {
    width: 56px;
    height: 56px;
    margin-right: 6px;
    background-color: var(--surface-1);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
}

.slot:hover,
.hotbar-slot:hover {
    border-color: var(--border-strong);
}

.slot-on,
.slot.is-selected,
.hotbar-slot.is-selected {
    border-color: var(--accent);
    border-width: 2px;
    background-color: var(--accent-muted);
}

.slot.is-drop-ok,
.hotbar-slot.is-drop-ok {
    border-color: var(--accent);
    border-width: 2px;
}

.slot.is-drop-bad {
    border-color: var(--danger);
}

.slot.is-empty {
    background-color: var(--bg-2);
}

.slot-key {
    position: absolute;
    left: 4px;
    top: 2px;
    font-size: 10px;
    color: var(--text-muted);
}

.slot-icon {
    width: 32px;
    height: 32px;
}

.empty-slot {
    margin-left: 12px;
    background-color: var(--bg-2);
}

.slot.is-dragging {
    opacity: 0.35;
}

/* ===== INVENTORY BAG ===== */

.bag {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100px;
    align-items: center;
}

.bag-panel {
    width: 70%;
    max-width: 900px;
    min-width: 560px;
    height: 50%;
    max-height: 540px;
    min-height: 320px;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    background-color: rgba(10, 13, 17, 0.96);
    border-color: var(--border-normal);
    border-top-width: 2px;
    border-top-color: var(--accent);
    border-left-width: 1px;
    border-left-color: var(--border-normal);
}

.bag-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 14px 20px 10px 20px;
    background-color: rgba(214, 148, 62, 0.06);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
}

.bag-title {
    font-size: 18px;
    color: var(--text-primary);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin: 0;
}

.bag-count {
    margin-left: 10px;
    padding: 1px 8px;
    font-size: 12px;
    color: var(--accent);
    -unity-font-style: bold;
    background-color: var(--accent-muted);
    border-radius: 2px;
}

.bag-close {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    border-radius: 2px;
}

.bag-close:hover {
    background-color: var(--surface-2);
}

/* --- category chips --- */

.bag-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    padding: 10px 20px 4px 20px;
}

.bag-chip {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 10px;
    margin: 0 6px 6px 0;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 13px;
    transition-property: background-color, border-color;
    transition-duration: 0.1s;
}

.bag-chip:hover {
    background-color: var(--surface-2);
    border-color: var(--border-normal);
}

.bag-chip.is-selected {
    background-color: var(--accent-muted);
    border-color: var(--accent);
}

.bag-chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    margin-right: 6px;
    background-color: var(--text-muted);
}

.bag-chip-label {
    font-size: 12px;
    color: var(--text-secondary);
}

.bag-chip.is-selected .bag-chip-label {
    color: var(--text-primary);
    -unity-font-style: bold;
}

.bag-chip-count {
    font-size: 11px;
    color: var(--text-muted);
    margin-left: 6px;
}

/* --- grid of fixed-size tiles --- */

.bag-panel .scroll,
.bag-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 6px 14px 6px 20px;
}

.bag-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.bag-tile {
    width: 118px;
    height: 150px;
    flex-shrink: 0;
    flex-grow: 0;
    margin: 0 10px 10px 0;
    padding: 12px 8px 8px 8px;
    align-items: center;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 3px;
    overflow: hidden;
    transition-property: translate, background-color, border-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.bag-tile:hover {
    translate: 0 -3px;
    background-color: var(--surface-2);
    border-color: var(--border-strong);
}

.bag-tile:active {
    translate: 0 0;
    background-color: var(--surface-interactive);
}

.bag-tile.is-equipped {
    border-color: rgba(214, 148, 62, 0.55);
}

.bag-tile-stripe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 3px;
    background-color: var(--text-muted);
}

.bag-tile-well {
    width: 68px;
    height: 68px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 34px;
    margin-bottom: 8px;
}

.bag-tile:hover .bag-tile-well {
    border-color: var(--border-strong);
}

.bag-tile-icon {
    width: 48px;
    height: 48px;
}

.bag-tile-name {
    width: 100%;
    height: 32px;
    flex-shrink: 0;
    font-size: 12px;
    color: var(--text-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    overflow: hidden;
    margin: 0;
}

.bag-tile-cost {
    font-size: 11px;
    color: var(--accent);
    margin-top: 4px;
    -unity-text-align: middle-center;
}

.bag-tile-slot {
    position: absolute;
    top: 7px;
    right: 7px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    font-size: 11px;
    color: rgb(20, 14, 6);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: var(--accent);
    border-radius: 2px;
}

/* category colours: stripe + chip dot */
.cat-logistics .bag-tile-stripe,
.cat-logistics .bag-chip-dot { background-color: var(--info); }
.cat-production .bag-tile-stripe,
.cat-production .bag-chip-dot { background-color: var(--accent); }
.cat-extraction .bag-tile-stripe,
.cat-extraction .bag-chip-dot { background-color: var(--warning); }
.cat-storage .bag-tile-stripe,
.cat-storage .bag-chip-dot { background-color: var(--success); }
.cat-research .bag-tile-stripe,
.cat-research .bag-chip-dot { background-color: var(--research); }
.cat-all .bag-chip-dot { background-color: var(--text-primary); }
.cat-decor .bag-tile-stripe,
.cat-decor .bag-chip-dot { background-color: rgb(196, 112, 168); }

/* --- footer hints --- */

.bag-footer {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    padding: 8px 20px;
    background-color: var(--bg-1);
    border-top-width: 1px;
    border-top-color: var(--border-subtle);
}

.bag-footer-hint {
    flex-direction: row;
    align-items: center;
    margin-right: 20px;
}

.drag-ghost {
    width: 48px;
    height: 48px;
    position: absolute;
    opacity: 0.85;
    scale: 0.9 0.9;
}

/* ===== HINTS / KEYCAPS ===== */

.hint-bar {
    position: absolute;
    left: 24px;
    bottom: 24px;
    flex-direction: column;
    align-items: flex-start;
    max-width: 280px;
}

.hint {
    background-color: var(--surface-overlay);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 2px;
    padding: 4px 8px;
    margin-right: 0;
    margin-bottom: 4px;
    flex-direction: row;
    align-items: center;
}

.keycap {
    min-width: 22px;
    height: 18px;
    padding: 0 6px;
    margin-right: 8px;
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border-normal);
    border-radius: 2px;
    align-items: center;
    justify-content: center;
}

.hint-key {
    color: var(--accent);
    font-size: 11px;
    -unity-font-style: bold;
    margin-right: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.hint-label {
    color: var(--text-secondary);
    font-size: 12px;
}

.key-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
}

.key-group {
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 1px;
    margin-top: 16px;
    margin-bottom: 8px;
}

/* ===== PROGRESS / STATUS ===== */

.progress-track {
    height: 6px;
    background-color: var(--bg-0);
    border-radius: 1px;
    overflow: hidden;
    margin-top: 8px;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.progress-fill {
    height: 6px;
    background-color: var(--accent);
    transition-property: width;
    transition-duration: 80ms;
    transition-timing-function: linear;
}

.status-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 8px;
    background-color: var(--text-muted);
    flex-shrink: 0;
}

.status-running .status-dot { background-color: var(--success); }
.status-ready .status-dot { background-color: var(--info); }
.status-warning .status-dot { background-color: var(--warning); }
.status-error .status-dot { background-color: var(--danger); }
.status-locked .status-dot { background-color: var(--text-disabled); }
.status-completed .status-dot { background-color: var(--success); }

.badge {
    padding: 2px 8px;
    border-width: 1px;
    border-radius: 2px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-left: 8px;
}

.badge-ready { border-color: var(--info); color: var(--info); }
.badge-running { border-color: var(--accent); color: var(--accent); }
.badge-done { border-color: var(--success); color: var(--success); }
.badge-locked { border-color: var(--text-disabled); color: var(--text-muted); }
.badge-warn { border-color: var(--warning); color: var(--warning); }
.badge-error { border-color: var(--danger); color: var(--danger); }

/* ===== FIELDS ===== */

.field {
    min-height: 48px;
    height: 48px;
    background-color: var(--surface-0);
    border-color: var(--border-normal);
    border-width: 1px;
    border-radius: 2px;
    padding: 0 4px;
    margin-bottom: 16px;
    color: var(--text-primary);
    font-size: 16px;
    justify-content: center;
    overflow: visible;
    flex-shrink: 0;
}

.search-field {
    min-height: 40px;
    height: 40px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.search-host .field,
.search-host .search-field {
    margin-bottom: 0;
}

.unity-base-text-field,
.unity-text-field,
TextField {
    min-height: 48px;
    height: 48px;
    justify-content: center;
    overflow: visible;
}

.unity-base-text-field__input,
.unity-base-field__input,
.unity-text-field__input {
    min-height: 40px;
    height: 40px;
    padding: 10px 12px;
    font-size: 16px;
    -unity-text-align: middle-left;
    overflow: hidden;
    color: var(--text-primary);
}

.unity-base-text-field__input > .unity-text-element,
.unity-text-field__input > .unity-text-element {
    -unity-text-align: middle-left;
    font-size: 16px;
    color: var(--text-primary);
}

.upgrade-btn {
    height: 32px;
    min-width: 108px;
    margin-bottom: 0;
    margin-left: 8px;
    margin-right: 4px;
    background-color: var(--accent-muted);
    border-color: var(--accent);
    flex-shrink: 0;
}

.upgrade-btn .btn-label {
    color: var(--accent);
    font-size: 13px;
}

.upgrade-btn:hover {
    background-color: rgba(214, 148, 62, 0.28);
}

.cat-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.cat-chip {
    height: 28px;
    margin-right: 8px;
    margin-bottom: 8px;
    padding: 0 12px;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 2px;
    justify-content: center;
}

.cat-chip:hover {
    border-color: var(--accent);
}

.cat-chip.is-selected {
    border-color: var(--accent);
    background-color: var(--accent-muted);
}

.cat-chip .btn-label {
    font-size: 12px;
}

/* ===== STACKS / IO ===== */

.stack-chip {
    width: 52px;
    min-width: 52px;
    height: 52px;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 2px;
    margin-right: 6px;
    margin-bottom: 4px;
    align-items: center;
    justify-content: flex-start;
    padding-top: 4px;
    overflow: visible;
}

.stack-icon {
    width: 28px;
    height: 28px;
}

.stack-count {
    position: absolute;
    left: 1px;
    right: 1px;
    bottom: 1px;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: visible;
    color: var(--text-primary);
}

.io-row {
    flex-wrap: wrap;
    margin-top: 6px;
}

.codex-card {
    align-items: stretch;
    flex-direction: column;
}

.codex-head {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
}

.codex-icon {
    width: 56px;
    height: 56px;
    margin-right: 12px;
    flex-shrink: 0;
}

.codex-source {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 6px;
}

.codex-building {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
    margin-bottom: 4px;
}

.codex-recipe {
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 2px;
    padding: 8px 10px;
    margin-bottom: 6px;
}

.codex-recipe.is-locked {
    opacity: 0.72;
}

.codex-search-row {
    align-items: center;
    flex-shrink: 0;
}

.codex-search-plus {
    width: 36px;
    height: 40px;
    margin-right: 8px;
    margin-bottom: 0;
    font-size: 22px;
    color: var(--accent);
    -unity-text-align: middle-center;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 2px;
}

.codex-search-row .search-field {
    flex-grow: 1;
    margin-bottom: 0;
}

/* ===== MAP ===== */

.mini-host {
    position: absolute;
    right: 24px;
    top: 24px;
}

.mini-map {
    flex-shrink: 0;
}

.map-frame {
    background-color: var(--surface-overlay);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: 2px;
    padding: 4px;
    overflow: hidden;
}

.map-chrome {
    align-self: center;
    margin-top: 32px;
    width: 88%;
    max-width: 1100px;
    height: 86%;
    padding: 16px 20px 12px 20px;
}

.map-full-wrap {
    flex-grow: 1;
    min-height: 360px;
    width: auto;
    height: auto;
}

.map-full {
    flex-grow: 1;
    width: auto;
    height: auto;
}

.map-legend {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.map-swatch {
    width: 10px;
    height: 10px;
    margin-right: 6px;
    border-radius: 1px;
}

.map-tools {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    flex-shrink: 0;
}

.mini-clip {
    overflow: hidden;
    position: relative;
    flex-grow: 1;
}

.map-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.player-mark {
    width: 22px;
    height: 22px;
    background-color: rgba(0, 0, 0, 0);
    position: absolute;
}

.map-pin {
    width: 10px;
    height: 10px;
    position: absolute;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(12, 14, 16);
}

.map-pin-name {
    position: absolute;
    left: 12px;
    top: -5px;
    font-size: 11px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.measure-label {
    position: absolute;
    background-color: rgba(12, 16, 20, 0.82);
    padding: 2px 6px;
    font-size: 12px;
    color: rgb(255, 230, 120);
}

.mini-info {
    margin-top: 6px;
    font-size: 12px;
    color: rgb(220, 228, 232);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.mini-clock {
    margin-top: 6px;
    margin-bottom: 4px;
    font-size: 13px;
    color: rgb(255, 236, 196);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0.4px;
}

.compass-letter {
    position: absolute;
    font-size: 13px;
    color: rgb(255, 230, 120);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.map-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 360px;
}

.map-side {
    width: 260px;
    margin-left: 12px;
    flex-shrink: 0;
}

.map-wp-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 4px;
    margin-bottom: 4px;
}

.map-edit {
    margin-top: 8px;
    padding: 10px;
    background-color: var(--surface-overlay);
    border-width: 1px;
    border-color: var(--border-subtle);
}

.map-compass {
    position: absolute;
    left: 12px;
    top: 8px;
    font-size: 18px;
    color: rgb(255, 230, 120);
    -unity-font-style: bold;
}

.map-pin-dist {
    position: absolute;
    left: 12px;
    top: -2px;
    font-size: 10px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

/* ===== TOOLTIP / TOAST / MODAL ===== */

.tooltip,
.ui-tooltip {
    position: absolute;
    background-color: rgba(8, 10, 14, 0.96);
    border-color: rgb(90, 100, 110);
    border-width: 1px;
    border-radius: 3px;
    padding: 8px 12px;
    font-size: 13px;
    color: rgb(230, 232, 228);
    max-width: 280px;
}

.ui-tooltip__title {
    font-size: 13px;
    color: var(--text-primary);
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.ui-tooltip__body {
    font-size: 12px;
    color: var(--text-secondary);
    white-space: normal;
}

.ui-tooltip__key {
    font-size: 11px;
    color: var(--accent);
    margin-top: 4px;
}

.toast-host {
    position: absolute;
    right: 24px;
    bottom: 96px;
    width: 320px;
    flex-direction: column;
    align-items: stretch;
}

.toast {
    background-color: var(--surface-overlay);
    border-width: 1px;
    border-color: var(--border-normal);
    border-left-width: 3px;
    border-left-color: var(--accent);
    border-radius: 2px;
    padding: 10px 12px;
    margin-bottom: 8px;
}

.toast-ok { border-left-color: var(--success); }
.toast-warn { border-left-color: var(--warning); }
.toast-error { border-left-color: var(--danger); }

.toast-title {
    font-size: 13px;
    color: var(--text-primary);
    -unity-font-style: bold;
}

.toast-body {
    font-size: 12px;
    color: var(--text-secondary);
    white-space: normal;
}

.modal-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.modal-box {
    width: 420px;
    max-width: 86%;
    background-color: var(--surface-elevated);
    border-width: 1px;
    border-color: var(--border-strong);
    border-left-width: 3px;
    border-left-color: var(--danger);
    padding: 24px;
}

.modal-actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-top: 24px;
}

.modal-actions .btn,
.modal-actions .btn-small,
.modal-actions .btn-danger,
.modal-actions .btn-primary,
.modal-actions .btn-ghost {
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 8px;
    height: 32px;
}

/* ===== RESEARCH TREE ===== */

.research-layout {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
}

.research-scroll,
.research-view {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.research-view {
    position: relative;
    background-color: rgb(48, 60, 74);
}

.research-view.is-panning {
    cursor: grab;
}

.research-canvas {
    position: absolute;
    left: 0;
    top: 0;
    flex-shrink: 0;
}

.research-tree {
    flex-grow: 1;
    flex-direction: row;
    padding-bottom: 12px;
}

.research-col {
    width: 220px;
    margin-right: 24px;
    flex-shrink: 0;
}

.research-node {
    flex-direction: column;
    align-items: stretch;
    width: 200px;
    min-height: 88px;
    margin-bottom: 16px;
    padding: 12px;
}

.research-tree-node {
    flex-direction: row;
    align-items: stretch;
    width: 216px;
    height: 80px;
    min-height: 80px;
    margin: 0;
    padding: 8px 10px 8px 0;
    overflow: hidden;
    flex-shrink: 0;
    background-color: rgb(64, 78, 94);
    border-width: 2px;
    border-color: rgb(112, 132, 150);
    border-radius: 4px;
}

Button.research-tree-node > .unity-text-element,
Button.research-tree-node > .unity-button__text {
    display: none;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
}

.research-tree-pip {
    width: 6px;
    min-height: 64px;
    margin-right: 8px;
    flex-shrink: 0;
    background-color: rgb(140, 156, 170);
}

.research-tree-icon {
    width: 52px;
    height: 52px;
    margin-right: 10px;
    flex-shrink: 0;
    align-self: center;
}

.research-tree-meta {
    justify-content: center;
    min-width: 0;
}

.research-tree-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(245, 248, 250);
    white-space: nowrap;
    overflow: hidden;
    margin-bottom: 2px;
}

.research-tree-status {
    font-size: 12px;
    letter-spacing: 0.5px;
    color: rgb(186, 198, 208);
}

.research-tree-node.is-complete {
    background-color: rgb(46, 78, 62);
    border-color: rgb(92, 176, 118);
    opacity: 1;
}

.research-tree-node.is-complete .research-tree-pip {
    background-color: rgb(92, 176, 118);
}

.research-tree-node.is-complete .research-tree-status {
    color: rgb(140, 210, 160);
}

.research-tree-node.is-active {
    background-color: rgb(92, 68, 40);
    border-color: rgb(232, 168, 78);
    opacity: 1;
}

.research-tree-node.is-active .research-tree-pip {
    background-color: rgb(232, 168, 78);
}

.research-tree-node.is-active .research-tree-status {
    color: rgb(232, 168, 78);
}

.research-tree-node.is-locked {
    background-color: rgb(52, 62, 74);
    border-color: rgb(86, 100, 114);
    opacity: 1;
}

.research-tree-node.is-locked .research-tree-title {
    color: rgb(206, 214, 220);
}

.research-tree-node.is-locked .research-tree-pip {
    background-color: rgb(96, 110, 124);
}

.research-tree-node.is-ready {
    background-color: rgb(86, 72, 48);
    border-color: rgb(232, 168, 78);
    opacity: 1;
}

.research-tree-node.is-ready .research-tree-pip {
    background-color: rgb(232, 168, 78);
}

.research-tree-node.is-ready .research-tree-status {
    color: rgb(232, 168, 78);
}

.research-tree-node.is-selected {
    border-width: 3px;
    border-color: rgb(255, 196, 96);
    background-color: rgb(102, 80, 46);
}

.research-node.is-complete {
    border-color: var(--success);
}

.research-node.is-active {
    border-color: var(--accent);
    background-color: var(--accent-muted);
}

.research-node.is-locked {
    opacity: 1;
}

.research-node.is-ready {
    border-color: var(--accent);
}

.research-node.is-selected {
    border-width: 2px;
    border-color: var(--accent);
    background-color: var(--accent-muted);
}

.research-detail {
    width: 300px;
    flex-shrink: 0;
    background-color: rgb(42, 52, 64);
    border-width: 1px;
    border-color: rgb(90, 108, 124);
    padding: 12px;
    margin-left: 8px;
    overflow: auto;
}

.research-detail .label-caps {
    margin-top: 10px;
    margin-bottom: 4px;
}

.research-detail .btn-primary {
    margin-top: 12px;
}

/* ===== STORAGE ===== */

.storage-slot {
    width: 96px;
    height: 96px;
    background-color: var(--surface-0);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: 2px;
    margin: 4px;
    align-items: center;
    justify-content: center;
}

.belt-mark {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 12px;
    flex-shrink: 0;
}

/* ===== MENU / WORLDS ===== */

.menu-stack {
    width: 420px;
    max-width: 86%;
}

.world-card {
    flex-direction: column;
    align-items: stretch;
    padding: 16px;
    margin-bottom: 12px;
}

.world-preview {
    width: 148px;
    height: 96px;
    margin-right: 14px;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--border-subtle);
    flex-shrink: 0;
}

.world-card .row {
    margin-top: 12px;
    justify-content: flex-end;
}

.settings-group {
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 1px;
    margin-top: 20px;
    margin-bottom: 8px;
}

.esc-hint {
    margin-top: 24px;
    font-size: 12px;
    color: var(--text-muted);
}

.pause-stats {
    margin-top: 8px;
    margin-bottom: 8px;
    white-space: normal;
}

.achieve-row {
    flex-direction: row;
    align-items: flex-start;
    padding: 8px 4px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
}

.achieve-row.is-on {
    background-color: var(--accent-muted);
}

.rate-block {
    margin-bottom: 8px;
}

.rate-track {
    height: 8px;
    flex-direction: row;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--border-subtle);
    margin-top: 2px;
}

.rate-fill {
    height: 100%;
}

.rate-fill-up {
    background-color: var(--success);
}

.rate-fill-down {
    background-color: var(--danger);
}

.map-layer {
    height: 28px;
    margin-right: 8px;
    padding-left: 6px;
    padding-right: 8px;
    flex-direction: row;
    align-items: center;
}

.map-layer.is-off {
    opacity: 0.35;
}

.idle-host {
    position: absolute;
    right: 24px;
    top: 88px;
    width: 280px;
    padding: 8px 10px;
    background-color: rgba(12, 10, 6, 0.82);
    border-width: 1px;
    border-color: rgb(180, 140, 40);
}

.idle-title {
    font-size: 12px;
    color: rgb(230, 190, 70);
    margin-bottom: 6px;
}

.idle-row {
    height: 28px;
    margin-bottom: 4px;
    justify-content: flex-start;
}

/* ===== DEBUG ===== */

.debug-outline {
    border-width: 1px;
    border-color: rgb(80, 200, 255);
}

.dev-console {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 24px;
    height: 46%;
    background-color: rgba(6, 8, 10, 0.94);
    border-width: 1px;
    border-color: rgb(40, 48, 56);
    padding: 10px 12px;
    flex-direction: column;
}

.dev-console-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.dev-console-title {
    font-size: 11px;
    color: rgb(120, 200, 120);
    letter-spacing: 2px;
}

.dev-console-log-wrap {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 80px;
    margin-bottom: 6px;
    position: relative;
}

.dev-console-log {
    flex-grow: 1;
    min-height: 80px;
}

.dev-console-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 0 4px;
    border-radius: 2px;
}

.dev-console-row:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.dev-console-row.is-copied {
    background-color: rgba(120, 200, 120, 0.22);
}

.dev-console-line {
    font-size: 13px;
    color: rgb(210, 220, 210);
    white-space: normal;
    flex-shrink: 1;
}

.dev-console-row.is-in .dev-console-line,
.dev-console-overlay-line.is-in {
    color: rgb(130, 190, 255);
}

.dev-console-row.is-ok .dev-console-line,
.dev-console-overlay-line.is-ok {
    color: rgb(150, 230, 150);
}

.dev-console-row.is-warn .dev-console-line,
.dev-console-overlay-line.is-warn {
    color: rgb(255, 205, 105);
}

.dev-console-row.is-err .dev-console-line,
.dev-console-overlay-line.is-err {
    color: rgb(255, 115, 100);
}

.dev-console-row.is-sys .dev-console-line,
.dev-console-overlay-line.is-sys {
    color: rgb(135, 148, 135);
}

.dev-console-count {
    font-size: 11px;
    color: rgb(20, 24, 20);
    background-color: rgb(150, 175, 150);
    border-radius: 6px;
    padding: 0 5px;
    margin-left: 6px;
}

.dev-console-btn {
    font-size: 12px;
    color: rgb(255, 210, 90);
    border-width: 1px;
    border-color: rgb(110, 92, 40);
    border-radius: 3px;
    padding: 0 5px;
    margin: 1px 0 1px 4px;
    background-color: rgba(255, 210, 90, 0.06);
}

.dev-console-btn:hover {
    background-color: rgba(255, 210, 90, 0.22);
    color: rgb(255, 235, 170);
}

.dev-console-head-btn {
    font-size: 11px;
    color: rgb(150, 175, 150);
    border-color: rgb(50, 64, 52);
    background-color: rgba(0, 0, 0, 0);
}

.dev-console-new {
    position: absolute;
    right: 14px;
    bottom: 6px;
    font-size: 12px;
    color: rgb(20, 24, 20);
    background-color: rgb(255, 210, 90);
    border-radius: 3px;
    padding: 2px 8px;
}

.dev-console-suggest {
    flex-shrink: 0;
    max-height: 196px;
    margin-bottom: 4px;
    padding: 2px 4px;
    background-color: rgba(0, 0, 0, 0.28);
    border-width: 1px;
    border-color: rgb(40, 52, 44);
}

.dev-console-suggest-line {
    font-size: 12px;
    color: rgb(150, 175, 150);
    padding: 1px 4px;
}

.dev-console-suggest-line:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.dev-console-suggest-line.is-on {
    color: rgb(225, 240, 225);
    background-color: rgba(120, 200, 120, 0.16);
}

.dev-console-hint {
    flex-shrink: 0;
    font-size: 12px;
    color: rgb(130, 150, 130);
    white-space: normal;
    padding: 2px 4px 4px 4px;
}

.dev-console-input-wrap {
    position: relative;
    height: 28px;
    flex-shrink: 0;
    margin-bottom: 0;
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 1px;
    border-color: rgb(50, 64, 52);
}

.dev-console-input-wrap.is-bad {
    border-color: rgb(200, 80, 70);
}

.dev-console-ghost {
    position: absolute;
    left: 8px;
    top: 5px;
    right: 8px;
    font-size: 14px;
    color: rgb(110, 130, 110);
    overflow: hidden;
}

.dev-console-input {
    height: 28px;
    margin-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(220, 235, 220);
}

.dev-console-input .unity-base-text-field__input,
.dev-console-input .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(220, 235, 220);
    padding-left: 8px;
    padding-top: 4px;
}

.dev-console-overlay {
    position: absolute;
    left: 24px;
    bottom: 150px;
    max-width: 50%;
    flex-direction: column;
    align-items: flex-start;
}

.dev-console-overlay-line {
    font-size: 13px;
    color: rgb(210, 220, 210);
    background-color: rgba(6, 8, 10, 0.72);
    padding: 2px 8px;
    margin-top: 2px;
    border-radius: 3px;
    white-space: normal;
}

/* Unity slider */
.unity-base-slider {
    height: 20px;
    margin-bottom: 16px;
}

.unity-base-slider__tracker {
    background-color: var(--surface-0);
    height: 4px;
}

.unity-base-slider__dragger {
    background-color: var(--accent);
    width: 12px;
    height: 12px;
}

/* ===== UNITY DEFAULT HOVER / FOCUS (kill white flash) ===== */

Button,
.unity-button,
Button:hover,
Button:focus,
Button:active,
Button:checked,
.unity-button:hover,
.unity-button:focus,
.unity-button:active,
.unity-button:checked {
    background-image: none;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgb(24, 30, 38);
    color: rgb(228, 232, 234);
    border-top-color: rgb(48, 58, 68);
    border-right-color: rgb(48, 58, 68);
    border-bottom-color: rgb(48, 58, 68);
    border-left-color: rgb(48, 58, 68);
}

Button:hover,
.unity-button:hover {
    background-image: none;
    background-color: rgb(28, 36, 44);
    color: rgb(228, 232, 234);
    border-top-color: rgb(214, 148, 62);
    border-right-color: rgb(214, 148, 62);
    border-bottom-color: rgb(214, 148, 62);
    border-left-color: rgb(214, 148, 62);
}

Button:hover > Label,
Button:hover .btn-label,
Button:hover .unity-text-element,
.unity-button:hover > .unity-text-element,
.unity-button:hover > Label {
    color: rgb(228, 232, 234);
}

Button.btn-primary:hover,
Button.btn-primary:hover .btn-label {
    background-color: rgba(214, 148, 62, 0.28);
    color: rgb(232, 168, 78);
}

Button.btn-danger:hover,
Button.btn-danger:hover .btn-label {
    background-color: rgba(186, 72, 68, 0.32);
    color: rgb(220, 140, 136);
}

Button.card,
Button.card:hover,
Button.card:focus,
Button.research-node,
Button.research-node:hover {
    background-image: none;
    background-color: rgb(18, 23, 29);
    color: rgb(228, 232, 234);
}

Button.card:hover,
Button.research-node:hover {
    background-color: rgb(24, 30, 38);
}

Button.research-tree-node,
Button.research-tree-node:hover,
Button.research-tree-node:focus {
    background-image: none;
    background-color: rgb(64, 78, 94);
    color: rgb(245, 248, 250);
    border-color: rgb(112, 132, 150);
}

Button.research-tree-node:hover {
    background-color: rgb(76, 92, 110);
    border-color: rgb(232, 168, 78);
}

Button.research-tree-node.is-ready,
Button.research-tree-node.is-ready:hover {
    background-color: rgb(86, 72, 48);
    border-color: rgb(232, 168, 78);
}

Button.research-tree-node.is-active,
Button.research-tree-node.is-active:hover {
    background-color: rgb(92, 68, 40);
    border-color: rgb(232, 168, 78);
}

Button.research-tree-node.is-complete,
Button.research-tree-node.is-complete:hover {
    background-color: rgb(46, 78, 62);
    border-color: rgb(92, 176, 118);
}

Button.research-tree-node.is-locked,
Button.research-tree-node.is-locked:hover {
    background-color: rgb(52, 62, 74);
    border-color: rgb(86, 100, 114);
}

Button.research-tree-node.is-selected,
Button.research-tree-node.is-selected:hover {
    background-color: rgb(102, 80, 46);
    border-color: rgb(255, 196, 96);
}

Button.card-on,
Button.card.is-selected,
Button.card:hover.card-on {
    background-color: rgba(214, 148, 62, 0.16);
}

TextField,
.unity-text-field,
.unity-base-text-field,
.unity-base-field,
.unity-base-text-field__input,
.unity-base-field__input,
.unity-text-field__input,
.field {
    background-image: none;
    background-color: rgb(14, 18, 23);
    color: rgb(228, 232, 234);
    border-top-color: rgb(48, 58, 68);
    border-right-color: rgb(48, 58, 68);
    border-bottom-color: rgb(48, 58, 68);
    border-left-color: rgb(48, 58, 68);
}

TextField:hover,
TextField:focus,
.field:hover,
.field:focus,
.unity-text-field:hover,
.unity-text-field:focus,
.unity-base-text-field:hover,
.unity-base-text-field:focus,
.unity-base-field:hover,
.unity-base-field:focus,
.unity-base-text-field__input:hover,
.unity-base-text-field__input:focus,
.unity-base-field__input:hover,
.unity-base-field__input:focus,
.unity-text-field__input:hover,
.unity-text-field__input:focus {
    background-image: none;
    background-color: rgb(18, 23, 29);
    color: rgb(228, 232, 234);
    border-top-color: rgb(214, 148, 62);
    border-right-color: rgb(214, 148, 62);
    border-bottom-color: rgb(214, 148, 62);
    border-left-color: rgb(214, 148, 62);
}

.unity-base-text-field__input > .unity-text-element,
.unity-text-field__input > .unity-text-element,
TextField .unity-text-element {
    color: rgb(228, 232, 234);
}

.unity-list-view__item:hover,
.unity-scroll-view .unity-button:hover {
    background-image: none;
    background-color: rgb(28, 36, 44);
    color: rgb(228, 232, 234);
}

.lang-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.lang-row .btn {
    margin-bottom: 0;
}

.tut-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.tut-dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 6, 8, 0.62);
}

.tut-panel {
    width: 560px;
    max-width: 90%;
    padding: 28px 32px 24px 32px;
}

.tut-actions {
    margin-top: 22px;
    justify-content: flex-end;
}

.tut-actions .btn {
    margin-left: 10px;
    margin-bottom: 0;
}

.tut-hud {
    position: absolute;
    left: 24px;
    top: 92px;
    width: 420px;
    max-width: 42%;
    padding: 12px 14px 10px 14px;
    background-color: var(--surface-overlay);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 2px;
}

.tut-hud-actions {
    margin-top: 8px;
    margin-bottom: 6px;
}

.tut-hud-actions .btn {
    margin-right: 8px;
    margin-bottom: 0;
    height: 28px;
}

.tut-goal {
    font-size: 16px;
    color: var(--text-primary);
    -unity-font-style: bold;
    margin-bottom: 6px;
    white-space: normal;
}

.tut-body {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 8px;
    white-space: normal;
}

.tut-skip {
    align-self: flex-start;
    margin-bottom: 0;
}

.tut-skip-hint {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
    margin-bottom: 0;
}

.tut-step {
    font-size: 11px;
    color: var(--accent);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.tut-progress-text {
    font-size: 12px;
    color: var(--text-secondary);
    margin-top: 4px;
    margin-bottom: 4px;
}

.tut-pointer {
    position: absolute;
    width: 60px;
    height: 60px;
    align-items: center;
    justify-content: center;
}

.tut-pointer-arrow {
    font-size: 34px;
    color: rgb(255, 208, 72);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    margin: 0;
    padding: 0;
}

.tut-pointer-dist {
    font-size: 12px;
    color: rgb(255, 236, 180);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
    margin: 0;
}

.tut-glow {
    border-width: 2px;
    border-color: rgb(255, 208, 72);
    background-color: rgba(255, 196, 64, 0.16);
}

.bp-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.bp-list {
    flex-direction: column;
}

.bp-card,
.bp-row {
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 2px;
    padding: 8px;
    margin: 6px;
}

.bp-card {
    flex-direction: column;
    width: 168px;
}

.bp-card.bp-lg {
    width: 200px;
}

.bp-card.bp-md {
    width: 148px;
}

.bp-card.bp-sm {
    width: 112px;
}

.bp-row {
    flex-direction: row;
    align-items: center;
    width: auto;
    margin-left: 0;
    margin-right: 0;
}

.bp-thumb {
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--border-subtle);
}

.bp-card .bp-thumb {
    width: 100%;
    height: 120px;
    margin-bottom: 8px;
}

.bp-card.bp-lg .bp-thumb {
    height: 148px;
}

.bp-card.bp-md .bp-thumb {
    height: 104px;
}

.bp-card.bp-sm .bp-thumb {
    height: 72px;
}

.bp-row .bp-thumb {
    width: 72px;
    height: 72px;
    margin-right: 12px;
    flex-shrink: 0;
}

.bp-name {
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}

.bp-on {
    border-color: var(--accent);
    background-color: var(--accent-muted);
}

/* ===== UI LOOK (settings: accent, animations, contrast, colorblind) ===== */

.root.accent-blue {
    --accent: rgb(84, 156, 220);
    --accent-hover: rgb(110, 176, 236);
    --accent-active: rgb(60, 128, 190);
    --accent-muted: rgba(84, 156, 220, 0.16);
}

.root.accent-green {
    --accent: rgb(96, 184, 120);
    --accent-hover: rgb(120, 204, 142);
    --accent-active: rgb(70, 152, 94);
    --accent-muted: rgba(96, 184, 120, 0.16);
}

.root.accent-red {
    --accent: rgb(210, 92, 84);
    --accent-hover: rgb(230, 116, 108);
    --accent-active: rgb(176, 68, 62);
    --accent-muted: rgba(210, 92, 84, 0.16);
}

.root.anim-reduced * {
    transition-duration: 0.04s;
}

.root.anim-off * {
    transition-duration: 0s;
}

.root.hi-contrast {
    --surface-overlay: rgba(4, 5, 7, 0.99);
    --surface-0: rgb(8, 10, 13);
    --surface-1: rgb(14, 18, 22);
    --surface-2: rgb(26, 32, 40);
    --border-subtle: rgb(80, 92, 104);
    --border-normal: rgb(120, 134, 146);
    --border-strong: rgb(180, 190, 198);
    --text-primary: rgb(255, 255, 255);
    --text-secondary: rgb(214, 220, 224);
    --text-muted: rgb(172, 182, 188);
}

/* protanopia / deuteranopia: blue = good, orange = bad, yellow = warning */
.root.cb-protan,
.root.cb-deutan {
    --success: rgb(64, 140, 255);
    --danger: rgb(255, 152, 26);
    --warning: rgb(242, 230, 76);
    --info: rgb(150, 190, 255);
}

/* tritanopia: teal = good, magenta = bad, pink = warning */
.root.cb-tritan {
    --success: rgb(52, 190, 190);
    --danger: rgb(242, 76, 115);
    --warning: rgb(255, 140, 152);
    --info: rgb(110, 210, 210);
}

/* ===== FPS COUNTER / CAPTIONS / HOLD PROMPT / TOAST POSITIONS ===== */

.fps-counter {
    position: absolute;
    left: 8px;
    top: 6px;
    padding: 2px 8px;
    font-size: 12px;
    color: rgb(170, 255, 170);
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 2px;
}

.caption-host {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 190px;
    align-items: center;
    flex-direction: column;
}

.caption-line {
    flex-direction: row;
    align-items: center;
    padding: 3px 12px;
    margin-top: 4px;
    background-color: rgba(0, 0, 0, 0.72);
    border-radius: 2px;
}

.caption-dir {
    font-size: 16px;
    color: var(--accent);
    -unity-font-style: bold;
    margin-right: 8px;
}

.caption-text {
    font-size: 15px;
    color: rgb(255, 255, 255);
}

.hold-prompt {
    position: absolute;
    left: 50%;
    top: 58%;
    translate: -50% 0;
    width: 360px;
    padding: 12px 16px;
    align-items: stretch;
}

.hold-text {
    font-size: 14px;
    color: var(--text-primary);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 8px;
}

.hold-track {
    height: 6px;
    border-radius: 3px;
    background-color: var(--surface-2);
    overflow: hidden;
}

.hold-fill {
    height: 100%;
    width: 0;
    background-color: var(--danger);
}

.toast-host.toast-pos-br {
    right: 24px;
    bottom: 96px;
    top: auto;
    left: auto;
}

.toast-host.toast-pos-tc {
    left: 50%;
    right: auto;
    top: 24px;
    bottom: auto;
    translate: -50% 0;
}

/* ===== WINDOWS (unified frame, same language as settings and the bag) ===== */

.panel.win {
    width: 90%;
    max-width: 1180px;
    height: 84%;
    max-height: 840px;
    min-height: 420px;
    padding: 0;
    flex-direction: column;
    overflow: hidden;
    background-color: rgba(10, 13, 17, 0.97);
    border-width: 1px;
    border-color: var(--border-normal);
    border-left-width: 1px;
    border-left-color: var(--border-normal);
    border-top-width: 2px;
    border-top-color: var(--accent);
    border-radius: 3px;
}

/* everything the windows put straight into the panel gets the content gutter */
.win > * {
    margin-left: 24px;
    margin-right: 24px;
}

.win > .win-header,
.win > .win-footer {
    margin-left: 0;
    margin-right: 0;
}

.win > .win-body,
.win > .col.grow {
    margin-bottom: 16px;
}

.win-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 60px;
    margin-bottom: 14px;
    padding: 12px 20px 12px 24px;
    background-color: rgba(214, 148, 62, 0.05);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
}

.win-icon {
    width: 36px;
    height: 36px;
    margin-right: 14px;
}

.win-titles {
    flex-direction: column;
    flex-shrink: 1;
    min-width: 0;
}

.win-title {
    font-size: 20px;
    color: var(--text-primary);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin: 0;
}

.win-sub {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
}

.win-header .btn-small {
    margin-left: 10px;
}

Button.win-close,
Button.win-close:hover,
Button.win-close:focus {
    flex-direction: row;
    align-items: center;
    height: 32px;
    margin: 0 0 0 12px;
    padding: 0 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 3px;
}

Button.win-close:hover {
    background-color: var(--surface-2);
    border-color: var(--border-normal);
}

.win-footer {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
    padding: 9px 24px;
    background-color: var(--bg-1);
    border-top-width: 1px;
    border-top-color: var(--border-subtle);
}

.win-hint {
    flex-direction: row;
    align-items: center;
    margin-right: 22px;
}

.win-nav {
    margin-right: 20px;
}

.win-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
}

.win-empty-title {
    font-size: 16px;
    color: var(--text-secondary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.win-empty-body {
    font-size: 13px;
    color: var(--text-muted);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 6px;
    max-width: 420px;
}

.dim {
    background-color: rgba(4, 6, 8, 0.62);
}

/* --- shared pieces restyled to the same language --- */

.tab-row {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-bottom: 12px;
}

Button.tab,
Button.tab:hover,
Button.tab:focus {
    flex-grow: 0;
    height: 30px;
    margin: 0 6px 6px 0;
    padding: 0 14px;
    background-color: var(--surface-0);
    border-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 15px;
}

Button.tab:hover {
    background-color: var(--surface-2);
    border-color: var(--border-normal);
}

Button.tab.is-selected,
Button.tab.tab-on,
Button.tab.is-selected:hover {
    background-color: var(--accent-muted);
    border-color: var(--accent);
}

Button.tab .btn-label {
    font-size: 13px;
    color: var(--text-secondary);
}

Button.tab.is-selected .btn-label,
Button.tab.tab-on .btn-label {
    color: var(--text-primary);
    -unity-font-style: bold;
}

Button.cat-chip,
Button.cat-chip:hover,
Button.cat-chip:focus {
    height: 28px;
    margin: 0 6px 6px 0;
    padding: 0 12px;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 14px;
}

Button.cat-chip:hover {
    background-color: var(--surface-2);
    border-color: var(--border-normal);
}

Button.cat-chip.is-selected,
Button.cat-chip.is-selected:hover {
    background-color: var(--accent-muted);
    border-color: var(--accent);
}

.label-caps {
    font-size: 11px;
    color: var(--accent);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.search-field,
.field {
    border-radius: 3px;
}

.status-row {
    padding: 8px 12px;
    margin-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.02);
    border-radius: 3px;
}

.progress-track {
    height: 6px;
    border-radius: 3px;
    background-color: var(--surface-2);
}

.progress-fill {
    border-radius: 3px;
}

.card,
Button.card {
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 3px;
    transition-property: translate, background-color, border-color;
    transition-duration: 0.12s;
}

.card:hover,
Button.card:hover {
    background-color: var(--surface-2);
    border-color: var(--border-strong);
}

.card.is-selected,
Button.card.is-selected,
Button.card-on,
Button.card:hover.card-on {
    background-color: var(--accent-muted);
    border-color: var(--accent);
}

.card-building {
    width: 150px;
    min-height: 0;
    height: 186px;
    margin: 0 10px 10px 0;
    padding: 14px 10px 10px 10px;
    align-items: center;
    overflow: hidden;
}

.card-building:hover {
    translate: 0 -3px;
}

.card-building .card-icon {
    width: 56px;
    height: 56px;
    margin: 0 0 8px 0;
}

.card-building .col {
    align-items: center;
}

.card-building .heading-3,
.card-building .muted {
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.stack-chip {
    border-radius: 3px;
    background-color: var(--bg-1);
}

.storage-slot {
    border-radius: 3px;
    background-color: var(--bg-1);
}

.storage-slot:hover {
    border-color: var(--border-strong);
}

.research-node {
    border-radius: 3px;
}

/* ===== WINDOW SIZES ===== */

.panel.win.win-narrow {
    width: 560px;
    max-width: 94%;
    height: auto;
    min-height: 0;
    max-height: 88%;
}

.panel.win.win-medium {
    width: 860px;
    max-width: 94%;
    height: 80%;
}

.panel.win.win-auto {
    width: 780px;
    max-width: 94%;
    height: auto;
    min-height: 0;
    max-height: 92%;
}

/* ===== TOOLBAR / ACTION ROW ===== */

.win-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    flex-shrink: 0;
}

.win-toolbar .tab-row {
    margin-right: 14px;
    margin-bottom: 6px;
}

.win-actions {
    flex-wrap: wrap;
    flex-shrink: 0;
    padding: 8px 10px;
    margin-bottom: 10px;
    background-color: rgba(255, 255, 255, 0.02);
    border-radius: 3px;
}

.win-actions .btn-small:first-child {
    margin-left: 0;
}

/* ===== BLUEPRINT TILES ===== */

.bp-card,
.bp-row {
    border-radius: 3px;
    padding: 8px;
    margin: 0 10px 10px 0;
    transition-property: translate, background-color, border-color;
    transition-duration: 0.12s;
}

.bp-card:hover {
    translate: 0 -3px;
    background-color: var(--surface-2);
    border-color: var(--border-strong);
}

.bp-row:hover {
    background-color: var(--surface-2);
    border-color: var(--border-strong);
}

.bp-thumb {
    border-radius: 3px;
    background-color: var(--bg-1);
}

/* ===== SELECTION GROUPS ===== */

.sel-card {
    flex-direction: row;
    align-items: center;
    padding: 12px 14px;
    margin-bottom: 8px;
}

.sel-well {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-right: 14px;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 32px;
}

.sel-icon {
    width: 44px;
    height: 44px;
}

.sel-count {
    position: absolute;
    right: -6px;
    bottom: -4px;
    padding: 1px 6px;
    font-size: 11px;
    color: rgb(20, 14, 6);
    -unity-font-style: bold;
    background-color: var(--accent);
    border-radius: 2px;
}

/* ===== SHOP ===== */

.shop-balances {
    flex-direction: row;
    flex-shrink: 0;
}

.shop-stat {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    padding: 14px 10px;
    margin-right: 10px;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 3px;
}

.shop-stat:last-child {
    margin-right: 0;
}

.shop-stat-icon {
    width: 40px;
    height: 40px;
    margin-bottom: 6px;
}

.shop-stat-value {
    font-size: 24px;
    -unity-font-style: bold;
}

.shop-stat-label {
    font-size: 12px;
    color: var(--text-muted);
}

.shop-offer .icon-32 {
    margin-right: 10px;
}

/* ===== DECOR SHOP ([[Decorations]]) ===== */

.shop-tabs {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 12px;
}

.shop-tabs .tab-row {
    margin-bottom: 0;
}

.shop-mini {
    flex-direction: row;
    align-items: center;
}

.shop-mini-icon {
    width: 20px;
    height: 20px;
    margin-left: 14px;
    margin-right: 6px;
}

.shop-mini-value {
    font-size: 16px;
    -unity-font-style: bold;
}

.decor-top {
    flex-direction: row;
    align-items: stretch;
    flex-shrink: 0;
    margin-bottom: 12px;
}

.decor-card {
    flex-grow: 1;
    flex-basis: 0;
    padding: 10px 14px;
    margin-right: 10px;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 3px;
}

.decor-card:last-child {
    margin-right: 0;
}

.decor-card-label {
    font-size: 11px;
    color: var(--text-muted);
    margin: 0;
}

.decor-card-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--text-primary);
    margin: 0;
}

.decor-card-sub {
    font-size: 11px;
    color: var(--text-secondary);
    white-space: normal;
    margin: 0;
}

.decor-bar {
    height: 6px;
    margin: 4px 0 4px 0;
}

.decor-deal {
    flex-direction: row;
    align-items: center;
}

.decor-deal:hover {
    background-color: var(--surface-2);
    border-color: var(--border-strong);
}

.decor-deal-icon {
    width: 52px;
    height: 52px;
    margin-right: 10px;
    flex-shrink: 0;
}

.decor-deal-name {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text-primary);
    white-space: normal;
    margin: 0;
}

.decor-chips {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.decor-set {
    font-size: 12px;
    color: var(--accent);
    margin: 2px 0 8px 2px;
    flex-shrink: 0;
}

.decor-grid {
    padding-top: 4px;
}

.bag-tile.decor-tile {
    width: 138px;
    height: 216px;
}

.decor-tile.is-owned {
    border-color: rgba(92, 176, 118, 0.5);
}

.decor-tile.is-locked .bag-tile-well {
    opacity: 0.55;
}

.decor-size {
    position: absolute;
    top: 8px;
    left: 7px;
    height: 16px;
    padding: 0 4px;
    font-size: 10px;
    color: var(--text-secondary);
    -unity-text-align: middle-center;
    background-color: var(--bg-1);
    border-radius: 2px;
}

.decor-deal-badge {
    position: absolute;
    top: 8px;
    right: 7px;
    height: 16px;
    padding: 0 4px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(20, 14, 6);
    -unity-text-align: middle-center;
    background-color: var(--accent);
    border-radius: 2px;
}

.decor-meta {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 2px;
    -unity-text-align: middle-center;
}

.decor-state {
    height: 30px;
    width: 100%;
    font-size: 11px;
    color: var(--success);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0;
}

.decor-state.is-locked {
    color: var(--text-muted);
}

.btn-small.decor-buy {
    width: 100%;
    min-width: 0;
    height: 30px;
    margin-left: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.decor-buy-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

.decor-hint {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 6px;
    flex-shrink: 0;
}

/* ===== MAP CHROME ===== */

.map-chrome.win {
    padding: 0;
}

.map-side {
    background-color: var(--bg-1);
    border-radius: 3px;
    padding: 4px 12px 12px 12px;
}

/* ===== MENUS (pause, main menu) ===== */

.panel-menu {
    padding: 28px 32px 24px 32px;
    background-color: rgba(10, 13, 17, 0.97);
    border-width: 1px;
    border-color: var(--border-normal);
    border-left-width: 1px;
    border-left-color: var(--border-normal);
    border-top-width: 2px;
    border-top-color: var(--accent);
    border-radius: 3px;
}

.panel-menu > .title-hero {
    font-size: 26px;
    color: var(--text-primary);
    letter-spacing: 3px;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-subtle);
}

.panel-menu > .btn {
    height: 42px;
    margin-bottom: 6px;
    border-radius: 3px;
}

.panel-menu > .divider {
    margin-top: 10px;
    margin-bottom: 10px;
}

.esc-hint {
    -unity-text-align: middle-center;
}

/* ===== MODAL ===== */

.modal-box {
    background-color: rgba(10, 13, 17, 0.98);
    border-width: 1px;
    border-color: var(--border-normal);
    border-top-width: 2px;
    border-top-color: var(--accent);
    border-radius: 3px;
    padding: 20px 24px;
    min-width: 400px;
    max-width: 520px;
}

.modal-actions {
    justify-content: flex-end;
    margin-top: 18px;
}

/* ===== HUD ===== */

.hud-chip {
    background-color: rgba(10, 13, 17, 0.88);
    border-left-width: 2px;
    border-left-color: var(--accent);
    border-radius: 3px;
}

.hint {
    border-radius: 3px;
}

.toast {
    border-radius: 3px;
    background-color: rgba(10, 13, 17, 0.94);
}

.tooltip,
.ui-tooltip {
    border-color: var(--border-normal);
    border-top-width: 2px;
    border-top-color: var(--accent);
    background-color: rgba(10, 13, 17, 0.97);
}

/* ===== ICON WELLS / CARD ROWS (recipes, filters, codex) ===== */

.card-well {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    margin-right: 14px;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 26px;
}

.card-well-icon {
    width: 36px;
    height: 36px;
}

.card-well.card-well-lg {
    width: 68px;
    height: 68px;
    border-radius: 34px;
}

.card-well.card-well-lg .card-well-icon {
    width: 48px;
    height: 48px;
}

.card:hover .card-well,
Button.card:hover .card-well {
    border-color: var(--border-strong);
}

.card-row {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    margin-bottom: 6px;
}

/* ===== STATS ===== */

.stat-row {
    flex-direction: row;
    align-items: center;
    min-height: 36px;
    padding: 6px 10px;
    margin-bottom: 2px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.015);
}

.stat-row:hover {
    background-color: var(--surface-1);
}

.stat-name {
    flex-grow: 1;
    font-size: 14px;
    color: var(--text-primary);
    margin-left: 10px;
}

.stat-value {
    font-size: 13px;
    color: var(--accent);
    -unity-font-style: bold;
}

.rate-track {
    border-radius: 2px;
    background-color: var(--surface-2);
    margin: 2px 10px 8px 10px;
}

/* ===== CODEX ===== */

.codex-card {
    padding: 14px 16px;
    margin-bottom: 10px;
}

.codex-recipe {
    background-color: var(--bg-1);
    border-radius: 3px;
}

.codex-search-plus {
    border-radius: 3px;
}

.codex-card .label-caps {
    margin-top: 8px;
    margin-bottom: 4px;
}

/* ===== RESEARCH TREE (game tokens instead of the old blue-gray) ===== */

.research-view {
    background-color: var(--bg-1);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 3px;
}

.research-tree-node {
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--border-normal);
    border-radius: 3px;
}

.research-tree-node:hover {
    background-color: var(--surface-2);
    border-color: var(--border-strong);
}

.research-tree-pip {
    background-color: var(--text-disabled);
}

.research-tree-title {
    font-size: 14px;
    color: var(--text-primary);
}

.research-tree-status {
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--text-muted);
}

.research-tree-node.is-complete {
    background-color: var(--surface-1);
    border-color: var(--success);
}

.research-tree-node.is-complete .research-tree-pip {
    background-color: var(--success);
}

.research-tree-node.is-complete .research-tree-status {
    color: var(--success);
}

.research-tree-node.is-active,
.research-tree-node.is-ready {
    background-color: var(--accent-muted);
    border-color: var(--accent);
}

.research-tree-node.is-active .research-tree-pip,
.research-tree-node.is-ready .research-tree-pip {
    background-color: var(--accent);
}

.research-tree-node.is-active .research-tree-status,
.research-tree-node.is-ready .research-tree-status {
    color: var(--accent);
}

.research-tree-node.is-locked {
    background-color: var(--surface-0);
    border-color: var(--border-subtle);
}

.research-tree-node.is-locked .research-tree-title {
    color: var(--text-secondary);
}

.research-tree-node.is-locked .research-tree-pip {
    background-color: var(--border-normal);
}

.research-tree-node.is-selected {
    border-width: 2px;
    border-color: var(--accent-hover);
    background-color: var(--accent-muted);
}

.research-detail {
    width: 320px;
    margin-left: 12px;
    padding: 14px 16px;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-top-width: 2px;
    border-top-color: var(--accent);
    border-radius: 3px;
}

/* ===== LOADING ===== */

.load-card {
    width: 680px;
    max-width: 92%;
    padding: 32px 36px 26px 36px;
}

.load-line {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 22px;
}

.load-status {
    font-size: 14px;
    color: var(--text-secondary);
}

.load-percent {
    font-size: 14px;
    color: var(--accent);
    -unity-font-style: bold;
}

.progress-track.load-track {
    height: 8px;
    margin-top: 8px;
    margin-bottom: 0;
}

.progress-fill.load-fill {
    height: 8px;
}

.load-tip {
    margin-top: 22px;
    padding: 10px 14px;
    background-color: var(--bg-1);
    border-left-width: 2px;
    border-left-color: var(--accent);
    border-radius: 3px;
}

.load-tip-text {
    font-size: 13px;
    color: var(--text-secondary);
    white-space: normal;
    margin-top: 4px;
}

/* ===== BUTTON TEXT FIX: label always centered and inside the button ===== */

Button > .btn-label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: nowrap;
    flex-shrink: 0;
}

Button.btn,
Button.tab,
Button.cat-chip,
Button.set-seg-btn,
Button.map-layer {
    justify-content: center;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
}

Button.btn {
    min-height: 28px;
}

/* key-binding buttons carry both btn-small and keycap: keep them tall enough for the text */
Button.keycap,
Button.btn-small.keycap {
    height: 28px;
    min-height: 28px;
    min-width: 64px;
    padding: 0 10px;
    margin-bottom: 0;
}

Button.keycap .btn-label {
    font-size: 12px;
    color: var(--accent);
    -unity-font-style: bold;
}

.keycap {
    height: 20px;
    min-height: 20px;
}

.keycap > .hint-key {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* ===== CHARACTER (экран «Персонаж»: превью + варианты) ===== */

.panel-menu.char-panel {
    width: 1040px;
    max-width: 94%;
    max-height: 92%;
}

.char-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.char-left {
    width: 340px;
    flex-shrink: 0;
    margin-right: 20px;
    align-items: center;
}

.char-preview {
    width: 340px;
    height: 486px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--border-subtle);
    background-color: rgb(20, 25, 32);
    -unity-background-scale-mode: scale-to-fit;
}

.char-preview:hover {
    border-color: var(--border-strong);
}

.char-hint {
    margin-top: 8px;
    -unity-text-align: middle-center;
}

.char-quick {
    margin-top: 8px;
    justify-content: center;
}

.char-options {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.char-row .set-text {
    width: 150px;
    flex-shrink: 0;
}

.char-row .set-ctl {
    flex-grow: 1;
    flex-shrink: 1;
}

.char-row .set-seg {
    justify-content: flex-start;
}

.char-swatches {
    flex-direction: row;
    flex-wrap: wrap;
}

.char-swatch {
    width: 24px;
    height: 24px;
    margin: 3px 6px 3px 0;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.35);
    transition-property: scale, border-color;
    transition-duration: 0.12s;
}

.char-swatch:hover {
    scale: 1.12 1.12;
    border-color: var(--border-strong);
}

.char-swatch.is-selected {
    border-color: var(--accent);
    scale: 1.15 1.15;
}

.char-footer {
    margin-top: 14px;
    align-items: center;
}

.char-footer > .btn-small:first-child {
    margin-left: 0;
}

/* ===== ECONOMY (вкладка статистики лаборатории) ===== */

.econ-graph {
    height: 140px;
    margin: 8px 0 4px 0;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--border-subtle);
    background-color: rgba(255, 255, 255, 0.02);
    flex-shrink: 0;
}

.econ-legend {
    margin-bottom: 8px;
}

/* ===== Карта производства (ProductionMapUI) ===== */

.pm-window .panel-wide {
    width: 1500px;
    max-width: 96%;
    height: 88%;
}

.pm-search {
    width: 220px;
    margin-right: 10px;
}

.pm-split {
    flex-grow: 1;
    min-height: 0;
}

.pm-graph-scroll {
    flex-grow: 1;
    margin-right: 12px;
    background-color: var(--surface-0);
    border-width: 1px;
    border-color: var(--border-subtle);
}

.pm-graph-content {
    position: relative;
    padding: 12px;
}

.pm-graph {
    align-items: flex-start;
}

.pm-edges {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.pm-col {
    width: 176px;
    margin-right: 34px;
}

.pm-col-head {
    margin-bottom: 8px;
    color: var(--text-muted);
}

.pm-tile {
    align-items: center;
    padding: 5px 7px;
    margin-bottom: 6px;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 2px;
}

.pm-tile:hover {
    border-color: var(--border-strong);
}

.pm-tile-icon {
    width: 28px;
    height: 28px;
    margin-right: 7px;
    flex-shrink: 0;
}

.pm-tile-name {
    font-size: 13px;
    color: var(--text-primary);
    white-space: normal;
}

.pm-tile-where {
    font-size: 11px;
    color: var(--text-muted);
}

.pm-tile-lock {
    display: none;
    font-size: 12px;
    margin-left: 4px;
}

.pm-tile.pm-locked {
    opacity: 0.45;
}

.pm-tile.pm-locked .pm-tile-lock {
    display: flex;
}

.pm-tile.pm-made {
    border-left-width: 3px;
    border-left-color: var(--success);
}

.pm-tile.pm-input {
    border-color: rgb(90, 215, 255);
    background-color: rgba(90, 215, 255, 0.10);
}

.pm-tile.pm-output {
    border-color: rgb(255, 190, 80);
    background-color: rgba(255, 190, 80, 0.08);
}

.pm-tile.pm-selected {
    border-width: 2px;
    border-color: var(--accent);
    background-color: var(--accent-muted);
    opacity: 1;
}

.pm-detail-scroll {
    width: 470px;
    flex-shrink: 0;
}

.pm-detail {
    padding: 4px 6px 16px 4px;
}

.pm-head {
    align-items: flex-start;
    margin-bottom: 8px;
}

.pm-head .card-well-lg {
    margin-right: 10px;
}

.pm-actions {
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.pm-actions .btn {
    margin-right: 8px;
}

.pm-section {
    margin-top: 14px;
    margin-bottom: 6px;
}

.pm-warn {
    color: var(--warning);
    white-space: normal;
}

.pm-row {
    align-items: center;
    margin-top: 4px;
}

.pm-row.pm-locked {
    opacity: 0.55;
}

.pm-branch {
    color: var(--text-muted);
    margin-right: 4px;
}

.pm-row-icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
}

.pm-row-name {
    font-size: 13px;
    color: var(--text-primary);
    -unity-font-style: bold;
    margin-right: 8px;
}

.pm-row-name:hover {
    color: var(--accent);
}

.pm-row-rate {
    font-size: 12px;
    color: var(--text-secondary);
}

.pm-row-where {
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 2px;
}

.pm-row-where .btn {
    margin-left: 6px;
    height: 22px;
}

.pm-machine {
    font-size: 12px;
    color: var(--accent);
    margin-right: 8px;
}

.pm-chips {
    flex-wrap: wrap;
}

.pm-chip {
    align-items: center;
    padding: 3px 7px;
    margin: 0 6px 6px 0;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 2px;
}

.pm-chip:hover {
    border-color: var(--accent);
}

.pm-chip-name {
    font-size: 12px;
    color: var(--text-primary);
}

.pm-ports {
    align-items: center;
    padding: 34px 0 12px 0;
}

.pm-port-box {
    position: relative;
    width: 150px;
    height: 150px;
    margin: 40px 120px;
    background-color: var(--surface-2);
    border-width: 2px;
    border-color: var(--border-strong);
    align-items: center;
    justify-content: center;
}

.pm-port-icon {
    width: 64px;
    height: 64px;
}

.pm-port {
    position: absolute;
    align-items: center;
}

.pm-port-arrow {
    font-size: 22px;
    -unity-font-style: bold;
    margin: 0;
}

.pm-port-label {
    font-size: 11px;
    white-space: normal;
    width: 110px;
    -unity-text-align: middle-center;
    margin: 0;
}

.pm-port.pm-back {
    bottom: -60px;
    left: 20px;
    right: 20px;
    flex-direction: column-reverse;
}

.pm-port.pm-front {
    top: -60px;
    left: 20px;
    right: 20px;
    flex-direction: column-reverse;
}

.pm-port.pm-back-l {
    bottom: -60px;
    left: -45px;
    width: 110px;
    flex-direction: column-reverse;
}

.pm-port.pm-back-r {
    bottom: -60px;
    right: -45px;
    width: 110px;
    flex-direction: column-reverse;
}

.pm-port.pm-left {
    left: -120px;
    top: 40px;
    width: 116px;
    flex-direction: column;
}

.pm-port.pm-right {
    right: -120px;
    top: 40px;
    width: 116px;
    flex-direction: column;
}

.pm-port-in .pm-port-arrow,
.pm-port-in .pm-port-label {
    color: rgb(110, 220, 120);
}

.pm-port-out .pm-port-arrow,
.pm-port-out .pm-port-label {
    color: rgb(255, 170, 70);
}

.pm-port-fluid .pm-port-arrow,
.pm-port-fluid .pm-port-label {
    color: rgb(90, 180, 255);
}

.pm-port-note {
    margin-top: 40px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ===== Цели и подсказки (GoalsUI) ===== */

.goal-hud {
    position: absolute;
    right: 24px;
    top: 24px;
    width: 300px;
    padding: 10px 12px 8px 12px;
    background-color: var(--surface-overlay);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 2px;
}

.goal-cond {
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 3px;
    white-space: normal;
}

.goal-cond-done {
    color: var(--success);
}

.goal-cond-link:hover {
    color: var(--accent);
}

.goal-track {
    margin-top: 8px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--border-subtle);
}

.hint-card {
    position: absolute;
    right: 24px;
    bottom: 150px;
    width: 340px;
    padding: 12px 14px 10px 14px;
    background-color: var(--surface-overlay);
    border-width: 1px;
    border-left-width: 3px;
    border-color: var(--border-subtle);
    border-left-color: var(--accent);
    border-radius: 2px;
}

.hint-card .btn {
    align-self: flex-end;
    margin-bottom: 0;
}

.goal-card {
    margin-bottom: 8px;
    padding: 10px 12px;
}

.goal-card-done {
    opacity: 0.6;
}

.goal-card-current {
    border-color: var(--accent);
    border-width: 2px;
}

/* ===== Снаряжение (PerkShopView) ===== */

.perk-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.perk-card {
    width: 31%;
    min-width: 230px;
    flex-grow: 1;
    margin: 0 8px 8px 0;
    padding: 10px 12px;
}

.perk-card.perk-owned {
    border-left-width: 3px;
    border-left-color: var(--success);
}

.perk-info {
    white-space: normal;
    margin-top: 4px;
    margin-bottom: 6px;
}

.perk-actions {
    align-items: center;
    flex-wrap: wrap;
    margin-top: auto;
}

.perk-actions .btn {
    margin-left: 6px;
    margin-bottom: 0;
}

/* ===== Хотбар снаряжения (GearHotbar) ===== */

.gear-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 22px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-end;
}

.gear-slot {
    width: 74px;
    height: 54px;
    margin: 0 3px;
    padding: 4px 5px;
    background-color: var(--surface-overlay);
    border-width: 1px;
    border-color: var(--border-subtle);
    border-radius: 2px;
    justify-content: flex-end;
}

.gear-slot-empty {
    opacity: 0.35;
}

.gear-slot-on {
    border-width: 2px;
    border-color: var(--accent);
    background-color: var(--accent-muted);
    opacity: 1;
}

.gear-slot-name {
    font-size: 11px;
    color: var(--text-primary);
    white-space: normal;
    -unity-text-align: lower-center;
}

.gear-bar-hint {
    position: absolute;
    bottom: 62px;
    left: 0;
    right: 0;
    font-size: 12px;
    color: var(--text-secondary);
    -unity-text-align: middle-center;
}

.gear-bag-slots {
    flex-wrap: wrap;
    margin: 8px 0 4px 0;
}

.gear-bag-slots .btn {
    margin: 0 6px 6px 0;
}

/* .card по умолчанию — строка; карточки целей и снаряжения — столбцом */
.card.goal-card,
.card.perk-card {
    flex-direction: column;
    align-items: stretch;
}

.card.perk-card .heading-3 {
    white-space: normal;
}

.gear-slot-icon {
    width: 30px;
    height: 30px;
    align-self: center;
    margin-bottom: 1px;
}

/* ===== Обменник: быстрые суммы и своё число ===== */

.shop-quick {
    flex-wrap: wrap;
    margin: 4px 0 6px 0;
}

.shop-quick .btn {
    margin: 0 6px 6px 0;
    min-width: 64px;
}

.shop-amount {
    width: 120px;
    margin: 0 10px 0 6px;
}

/* ===== Редактор таблички (SignEditorUI) ===== */

.panel.win.sign-win {
    max-width: 1240px;
}

.sign-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.sign-left {
    width: 584px;
    flex-shrink: 0;
    margin-right: 20px;
    min-height: 0;
}

.sign-right {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.sign-preview {
    width: 584px;
    height: 365px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--border-normal);
    border-radius: 3px;
    background-color: rgb(19, 23, 28);
    overflow: hidden;
}

.sign-preview-img {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.sign-select {
    position: absolute;
    border-width: 2px;
    border-color: var(--accent);
    border-radius: 3px;
    background-color: rgba(214, 148, 62, 0.06);
}

.sign-preview-hint {
    font-size: 12px;
    color: var(--text-muted);
    white-space: normal;
    margin: 6px 0 6px 0;
}

.sign-swatches {
    flex-wrap: wrap;
    justify-content: flex-start;
    max-width: 100%;
}

.sign-swatch {
    width: 20px;
    height: 20px;
    margin: 2px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
}

.sign-swatch:hover {
    border-color: var(--text-secondary);
}

.sign-swatch.is-selected {
    border-width: 2px;
    border-color: var(--accent);
}

TextField.sign-hex {
    width: 92px;
    margin: 2px 0 2px 6px;
}

.sign-list-head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.sign-add {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin: 4px 0 4px 0;
}

.sign-add .btn,
.sign-actions .btn,
.sign-presets .btn {
    margin: 0 6px 6px 0;
}

ScrollView.sign-list {
    flex-grow: 0;
    flex-shrink: 0;
    max-height: 200px;
    margin-bottom: 4px;
}

.sign-el {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    padding: 3px 8px;
    margin-bottom: 2px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(255, 255, 255, 0.02);
}

.sign-el:hover {
    background-color: var(--surface-1);
}

.sign-el.is-selected {
    border-color: var(--accent);
    background-color: var(--accent-muted);
}

.sign-el-badge {
    width: 26px;
    height: 26px;
    margin-right: 10px;
    border-radius: 3px;
    background-color: var(--surface-2);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.sign-el-badge-label {
    font-size: 15px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.sign-el-icon {
    width: 22px;
    height: 22px;
}

.sign-el-title {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    font-size: 13px;
    color: var(--text-primary);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.sign-el-kind {
    flex-shrink: 0;
    margin: 0 0 0 8px;
    font-size: 11px;
    color: var(--text-muted);
}

TextField.sign-textfield {
    margin: 2px 0 0 0;
}

TextField.sign-textfield .unity-text-field__input {
    min-height: 66px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.sign-glyphs,
.sign-icons {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0 8px 0;
}

.sign-glyph {
    width: 34px;
    height: 34px;
    margin: 0 4px 4px 0;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--border-subtle);
    background-color: var(--surface-0);
    align-items: center;
    justify-content: center;
}

.sign-glyph:hover {
    border-color: var(--border-strong);
    background-color: var(--surface-2);
}

.sign-glyph.is-selected {
    border-color: var(--accent);
    background-color: var(--accent-muted);
}

.sign-glyph-label {
    margin: 0;
    padding: 0;
    font-size: 18px;
    color: var(--text-primary);
    -unity-text-align: middle-center;
}

.sign-icon-btn {
    width: 42px;
    height: 42px;
}

.sign-icon-img {
    width: 32px;
    height: 32px;
}

.sign-actions,
.sign-presets {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 6px 0 4px 0;
}

.sign-win .set-row {
    min-height: 38px;
    padding: 4px 8px;
}

.sign-win .set-text {
    min-width: 96px;
    padding-right: 8px;
}

.sign-win .set-ctl {
    max-width: 80%;
}

.sign-win .set-slider {
    width: 170px;
}

.sign-win .set-value {
    width: 54px;
    margin-left: 8px;
}
